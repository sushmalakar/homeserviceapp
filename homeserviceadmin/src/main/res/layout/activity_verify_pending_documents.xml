<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <!-- Provider Name TextView -->
    <TextView
        android:id="@+id/providerNameTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Provider Name"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp"
        android:textColor="@android:color/black" />

    <!-- Provider ID TextView -->
    <TextView
        android:id="@+id/providerIdTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/providerNameTextView"
        android:text="Provider ID"
        android:textSize="16sp"
        android:layout_marginBottom="8dp"
        android:textColor="@android:color/black" />

    <!-- Document ID TextView -->
    <TextView
        android:id="@+id/documentIdTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/providerIdTextView"
        android:text="Document ID"
        android:textSize="16sp"
        android:layout_marginBottom="8dp"
        android:textColor="@android:color/black" />

    <!-- Document Status TextView -->
    <TextView
        android:id="@+id/documentStatusTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/documentIdTextView"
        android:text="Status"
        android:textSize="16sp"
        android:layout_marginBottom="8dp"
        android:textColor="@android:color/black" />

    <!-- Front ImageView -->
    <ImageView
        android:id="@+id/frontDocumentImageView"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_below="@id/documentStatusTextView"
        android:layout_marginTop="16dp"
        android:layout_alignParentStart="true"
        android:contentDescription="Front Document Image" />

    <!-- Back ImageView -->
    <ImageView
        android:id="@+id/backDocumentImageView"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_below="@id/documentStatusTextView"
        android:layout_marginTop="16dp"
        android:layout_alignParentEnd="true"
        android:contentDescription="Back Document Image" />

    <!-- Verify Button -->
    <Button
        android:id="@+id/verifyDocumentButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/frontDocumentImageView"
        android:layout_marginTop="16dp"
        android:text="Verify" />

    <!-- Reject Button -->
    <Button
        android:id="@+id/rejectDocumentButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/frontDocumentImageView"
        android:layout_marginTop="16dp"
        android:layout_toEndOf="@id/verifyDocumentButton"
        android:text="Reject" />

</RelativeLayout>
